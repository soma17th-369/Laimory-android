<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 사진 수집(MediaStore). 수집 영역이 MediaStore 접근을 소유하므로 이 모듈에서 선언한다. -->
    <!-- Android 12 이하: 저장소 읽기. Android 13+에서는 세분화 권한으로 대체되므로 maxSdkVersion 을 둔다. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+(API 33): 이미지 전용 권한. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+(API 34): 부분 허용(선택한 사진만) 상태를 표현. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 사진 EXIF 위치 읽기. Android 10+는 위치가 redact 되므로 이 권한 + setRequireOriginal 이 필요하다. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- 일정 수집(CalendarContract). 개인(owner-access) 캘린더 일정을 읽는다. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- 건강 수집(Health Connect). 초기 범위 걸음수·수면. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- 수면 기록(HC 프로듀서). Sleep API 감지·사용자 입력분을 HC 에 써넣는다(에픽 #142). -->
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />

    <!-- 위치 수집(LocationManager). Phase 2 는 Foreground Service 로 백그라운드에서도 지속한다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 백그라운드 위치(Android 10+). 부팅/프로세스 재시작 등 앱 미가시 컨텍스트의 수집에 필요. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Foreground Service(위치). Android 14+는 세분화 타입 권한이 별도. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 재부팅 후 수집 복원. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- FGS 상시 알림 표시(Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 이동수단 인식(Activity Recognition). 정식 transport 판정용(없으면 속도 추론 fallback). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 패키지 visibility(Android 11+). Health Connect 앱 + 알림 필터 앱 선택용 런처 앱 목록. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- 알림 실시간 수집 리스너. 시스템이 BIND 권한으로 바인딩한다(사용자가 '알림 접근'을 켠 동안). -->
        <service
            android:name="com.soma369.laimory.core.collection.notification.LaimoryNotificationListenerService"
            android:exported="false"
            android:label="Laimory 알림 수집"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 위치 수집 Foreground Service(백그라운드 지속). 상시 알림으로 수집 상태를 알린다. -->
        <service
            android:name="com.soma369.laimory.core.collection.location.LocationCollectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 재부팅 후 수집 복원(추적 원함 상태였으면 FGS 재시작). -->
        <receiver
            android:name="com.soma369.laimory.core.collection.location.LocationBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Activity Recognition 전이 결과 수신(우리 PendingIntent 로만 트리거되므로 exported=false). -->
        <receiver
            android:name="com.soma369.laimory.core.collection.location.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- Sleep API 감지 이벤트(segment·classify) 수신(우리 PendingIntent 로만 트리거되므로 exported=false). -->
        <receiver
            android:name="com.soma369.laimory.core.collection.health.SleepReceiver"
            android:exported="false" />

        <!-- 재부팅 후 수면 감지 구독 복원(사용자가 켜둔 상태였으면 재구독). -->
        <receiver
            android:name="com.soma369.laimory.core.collection.health.SleepBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>