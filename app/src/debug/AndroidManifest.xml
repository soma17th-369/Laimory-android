<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            debug 는 크래시를 원격으로 보내지 않는다. 개발 중 크래시는 디버거로 즉시 보므로 보낼
            값이 없고, 실험 중인 데이터가 브레드크럼에 섞여 Google 로 나간다. 런타임 분기가 아니라
            매니페스트로 끊는 이유는 SDK 가 프로세스 시작 시점에 이 값을 읽기 때문이다 — 코드가
            돌기 전에 터진 크래시까지 막으려면 여기여야 한다.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
            Health Connect 권한 rationale. 건강 권한과 함께 debug 에서만 선언한다 — 권한 선언은
            `core:collection` 의 debug 매니페스트에 있고, 둘은 함께 옮겨야 한다. release 에 이 화면만
            남으면 Play 심사가 Health Connect 를 쓰는 앱으로 본다.

            `exported` 는 main 과 같은 값을 다시 적는다. 병합 결과는 main 값을 받지만, 린트는 이 파일만
            따로 보고 intent-filter 가 있는 activity 에 값이 없다고 막는다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Android 13 이하 legacy. 이게 없으면 HC 권한 상태가 무효 처리된다. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+. 미선언 시 read 가 IllegalStateException 을 던진다. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
