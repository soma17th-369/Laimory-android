<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            debug 는 크래시를 원격으로 보내지 않는다. 개발 중 크래시는 디버거로 즉시 보므로 보낼
            값이 없고, 실험 중인 데이터가 브레드크럼에 섞여 Google 로 나간다. 런타임 분기가 아니라
            매니페스트로 끊는 이유는 SDK 가 프로세스 시작 시점에 이 값을 읽기 때문이다 — 코드가
            돌기 전에 터진 크래시까지 막으려면 여기여야 한다.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
            제품 분석은 debug 에서만 켠다. 이벤트가 실제로 나가는지 DebugView 로 확인할 곳이
            필요한데, 운영·QA 에서 켜면 동의 여부가 정해지기 전에 수집이 시작된다.

            같은 Firebase 프로젝트를 세 빌드가 함께 써서 debug 이벤트도 같은 GA4 속성에 쌓인다.
            앱(스트림)으로 걸러 볼 수는 있으나 기본 보기에는 섞인다 — 프로젝트를 나눌지는 #410 에
            결정 사항으로 남아 있다.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="true"
            tools:replace="android:value" />
    </application>

</manifest>
