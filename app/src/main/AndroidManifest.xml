<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        분석 SDK(#410)가 광고 측정용으로 병합해 오는 권한들을 도로 뺀다. 우리는 광고를 하지 않고
        광고 식별자 수집도 꺼 두므로 쓰지 않는데, 선언만 남으면 스토어 데이터 보안에 광고 목적을
        적어야 하고 사용자에게도 그렇게 보인다. 분석 도입 전 스토어 빌드에는 없던 권한이다.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".LaimoryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Laimory">

        <!--
            Google Maps Android API 키. local.properties 에서 주입하며 비어 있으면 SDK 인증이
            실패해 지도 영역이 대체 안내로 떨어진다(빌드는 성공한다).
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="timeline_draft_completion" />

        <!--
            제품 분석(GA4). 수집은 따로 동의를 받지 않고 켠다 — 처리방침에 수집 항목·목적을 고지하는
            것으로 갈음한다. qa 는 개발자 테스트 이벤트가 운영 지표에 섞이지 않게 자기 소스셋에서 끈다.

            광고 식별자와 광고 개인화는 끈다. 우리는 광고를 하지 않고, 켜 두면 수집 범위가 제품
            지표 밖으로 넓어져 처리방침·데이터 보안 선언까지 달라진다.

            자동 화면 기록도 끈다. Activity 가 하나뿐이라 모든 화면이 MainActivity 한 줄로 찍혀
            지표가 되지 않는다. 화면 단위가 필요해지면 route 를 실어 직접 보낸다.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="true" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- HiltWorkerFactory를 쓰는 사용자 정의 WorkManager Configuration이 기본 초기화를 대신한다. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <service
            android:name=".push.LaimoryFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            uiMode 는 우리가 직접 받는다. OS 의 다크 모드가 바뀌면 Compose 가 그 값을 읽어 다시
            그리므로 액티비티를 새로 만들 이유가 없다. 재생성하면 보고 있던 화면이 사라지고 화면이
            한 번 번쩍인다.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Laimory.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- #156: 환경별 서버의 assetlinks.json과 검증하는 OAuth App Link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${authCallbackHost}"
                    android:path="/auth/app" />
            </intent-filter>

            <!-- Health Connect 권한 rationale (Android 13 이하 legacy). 이게 없으면 HC 권한 상태가 무효 처리된다. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect 권한 rationale (Android 14+). 미선언 시 read 가 IllegalStateException 을 던진다. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
