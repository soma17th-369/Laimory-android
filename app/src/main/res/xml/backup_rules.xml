<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 미만 기기의 Auto Backup 규칙. API 31 이상은 data_extraction_rules.xml 을 쓴다.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    <exclude domain="file" path="datastore/active_timeline_draft.preferences_pb" />
    <!--
   기기 로컬 수집 원본. Auto Backup 은 앱 데이터베이스를 기본 백업 대상으로 삼는데, 이 DB 는
   알림 본문·위치 체류 같은 개인정보를 담고 보존 기간이 지나면 지워지는 기기 전용 데이터다.
   백업에 들어가면 앱을 지워도 재설치·기기 이전으로 되살아나므로, 계정 삭제 안내의
   "앱을 삭제하면 지워집니다" 가 거짓이 된다. WAL·SHM 은 별도 파일이라 함께 제외한다.
-->
    <exclude domain="database" path="collection.db" />
    <exclude domain="database" path="collection.db-wal" />
    <exclude domain="database" path="collection.db-shm" />
</full-backup-content>
