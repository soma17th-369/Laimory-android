digraph "modules" {
edge ["dir"="forward"]
graph ["dpi"="150" "rankdir"="TB"]
node ["shape"="rectangle" "style"="filled"]

"app" ["label"="app" "fillcolor"="#AED6F1"]
"core-collection" ["label"="core:collection" "fillcolor"="#FAD7A0"]
"core-data" ["label"="core:data" "fillcolor"="#FAD7A0"]
"core-domain" ["label"="core:domain" "fillcolor"="#D2B4DE"]
"core-ui" ["label"="core:ui" "fillcolor"="#FAD7A0"]
"core-util" ["label"="core:util" "fillcolor"="#FAD7A0"]
"feature-collection" ["label"="feature:collection" "fillcolor"="#A9DFBF"]
"feature-feature1" ["label"="feature:feature1" "fillcolor"="#A9DFBF"]
"feature-home" ["label"="feature:home" "fillcolor"="#A9DFBF"]
"feature-login" ["label"="feature:login" "fillcolor"="#A9DFBF"]
"feature-settings" ["label"="feature:settings" "fillcolor"="#A9DFBF"]
"feature-timeline" ["label"="feature:timeline" "fillcolor"="#A9DFBF"]

// edges
"app" -> "core-collection"
"app" -> "core-data"
"app" -> "core-domain"
"app" -> "core-ui"
"app" -> "core-util"
"app" -> "feature-collection"
"app" -> "feature-feature1"
"app" -> "feature-home"
"app" -> "feature-login"
"app" -> "feature-settings"
"app" -> "feature-timeline"
"core-collection" -> "core-domain"
"core-collection" -> "core-util"
"core-data" -> "core-domain"
"core-ui" -> "core-domain"
"core-ui" -> "core-util"
"feature-collection" -> "core-domain"
"feature-collection" -> "core-ui"
"feature-feature1" -> "core-domain"
"feature-feature1" -> "core-ui"
"feature-home" -> "core-domain"
"feature-home" -> "core-ui"
"feature-login" -> "core-domain"
"feature-login" -> "core-ui"
"feature-settings" -> "core-domain"
"feature-settings" -> "core-ui"
"feature-timeline" -> "core-domain"
"feature-timeline" -> "core-ui"
}